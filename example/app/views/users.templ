package views

import (
	"fmt"
	"github.com/golaravel/golaravel/example/app"
	"github.com/golaravel/golaravel/pkg/view"
)

// UsersList renders the user directory with an add user form.
templ UsersList(users []*app.User, csrfToken string) {
	@Layout("User Directory (Ent ORM)") {
		<div class="space-y-8 max-w-4xl mx-auto">
			<div class="flex items-center justify-between">
				<div>
					<h2 class="text-2xl font-bold text-white">Users Directory</h2>
					<p class="text-sm text-slate-400">Powered by Ent ORM and Templ rendering</p>
				</div>
				<span class="px-3 py-1 bg-rose-500/20 text-rose-300 text-xs font-semibold rounded-full border border-rose-500/30">
					{ fmt.Sprintf("%d Total Users", len(users)) }
				</span>
			</div>

			<!-- Add User Form with CSRF -->
			<div class="bg-slate-800/60 border border-slate-700/80 p-6 rounded-xl">
				<h3 class="text-lg font-semibold text-slate-100 mb-4">Add New User</h3>
				<form action="/users" method="POST" class="space-y-4">
					@view.CSRF(csrfToken)
					<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
						<div>
							<label class="block text-xs font-medium text-slate-400 mb-1">Name</label>
							<input type="text" name="name" required placeholder="Jane Doe" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-none focus:border-rose-500"/>
						</div>
						<div>
							<label class="block text-xs font-medium text-slate-400 mb-1">Email</label>
							<input type="email" name="email" required placeholder="jane@example.com" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-100 focus:outline-none focus:border-rose-500"/>
						</div>
					</div>
					<button type="submit" class="bg-rose-600 hover:bg-rose-500 text-white font-medium px-4 py-2 rounded-lg text-sm transition-colors">
						Create User
					</button>
				</form>
			</div>

			<!-- User List Table -->
			<div class="bg-slate-800/40 border border-slate-700/60 rounded-xl overflow-hidden">
				<table class="w-full text-left text-sm text-slate-300">
					<thead class="bg-slate-800/80 text-xs uppercase text-slate-400 border-b border-slate-700">
						<tr>
							<th class="px-6 py-3">ID</th>
							<th class="px-6 py-3">Name</th>
							<th class="px-6 py-3">Email</th>
							<th class="px-6 py-3">Created</th>
						</tr>
					</thead>
					<tbody class="divide-y divide-slate-800">
						if len(users) == 0 {
							<tr>
								<td colspan="4" class="px-6 py-8 text-center text-slate-500">
									No users found. Create one above!
								</td>
							</tr>
						}
						for _, u := range users {
							<tr class="hover:bg-slate-800/40">
								<td class="px-6 py-4 font-mono text-xs text-rose-400">{ fmt.Sprint(u.ID) }</td>
								<td class="px-6 py-4 font-semibold text-white">{ u.Name }</td>
								<td class="px-6 py-4 text-slate-400">{ u.Email }</td>
								<td class="px-6 py-4 text-xs text-slate-500">{ u.CreatedAt.Format("2006-01-02 15:04") }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		</div>
	}
}
